# 릴리스 서명 설정 예시. 이 파일을 복사해 keystore.properties로 저장하고 값을 채우세요.
# (keystore.properties와 *.keystore 는 git에 커밋되지 않습니다.)
#
# 1) keytool로 키스토어 생성 (android 폴더에서 실행):
#    keytool -genkey -v -keystore court-mate-release.keystore -alias courtmate -keyalg RSA -keysize 2048 -validity 10000
# 2) 아래 값을 채웁니다.

storeFile=court-mate-release.keystore
storePassword=여기에_키스토어_비밀번호
keyAlias=courtmate
keyPassword=여기에_키_비밀번호
